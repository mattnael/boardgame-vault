<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tambah Koleksi - Boardgame Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#141414] text-white min-h-screen font-sans">
    
    <header class="sticky top-0 z-50 bg-[#141414]/90 backdrop-blur px-6 py-4 flex justify-between items-center border-b border-zinc-800">
        <h1 class="text-red-600 font-black text-2xl tracking-tighter uppercase">Boardgame Vault</h1>
        <a href="/" class="text-xs px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded font-medium transition">&larr; Kembali ke Beranda</a>
    </header>

    <main class="max-w-xl mx-auto px-6 py-10 space-y-6">
        <div class="border-b border-zinc-800 pb-4">
            <h2 class="text-xl font-bold text-white">Tambah Koleksi Baru</h2>
            <p class="text-xs text-zinc-400 mt-0.5">Unggah poster gambar game langsung dari perangkatmu.</p>
        </div>

        <form action="/games" method="POST" enctype="multipart/form-data" class="bg-zinc-900 border border-zinc-800 p-6 rounded-xl shadow-2xl space-y-4">
            <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Judul Game</label>
                <input type="text" name="title" required placeholder="Cth: Catan" 
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600 transition">
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Kategori</label>
                    <input type="text" name="category" required placeholder="Cth: Strategi" 
                        class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600 transition">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Durasi (Menit)</label>
                    <input type="number" name="duration" required placeholder="90" 
                        class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600 transition">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Kesulitan</label>
                    <select name="difficulty" class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600 transition">
                        <option value="Mudah">Mudah</option>
                        <option value="Sedang">Sedang</option>
                        <option value="Berat">Berat</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Upload Poster Gambar</label>
                    <input type="file" name="image" accept="image/*" 
                        class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-2 py-1.5 text-xs text-zinc-400 file:mr-2 file:py-1 file:px-2 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-red-600 file:text-white transition">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-zinc-400 uppercase tracking-wider mb-1">Ulasan Singkat</label>
                <textarea name="review" rows="3" placeholder="Tulis ulasan..." 
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600 transition"></textarea>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-lg text-sm transition shadow-lg shadow-red-600/30">Tambahkan ke Vault</button>
                <a href="/" class="px-5 py-3 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-center rounded-lg text-sm transition">Batal</a>
            </div>
        </form>
    </main>
</body>
</html>