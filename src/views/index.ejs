<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boardgame Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen p-6 font-sans">
    <main class="max-w-4xl mx-auto space-y-8">
        <header class="border-b border-slate-800 pb-4">
            <h1 class="text-3xl font-bold tracking-tight text-indigo-400">Boardgame Vault</h1>
            <p class="text-sm text-slate-400 mt-1">Katalog koleksi dan pelacak ulasan permainan papan.</p>
        </header>

        <!-- Form Tambah Data -->
        <section class="bg-slate-900 border border-slate-800 p-6 rounded-2xl shadow-xl space-y-4">
            <h2 class="text-lg font-semibold text-slate-200">Tambah Koleksi Baru</h2>
            <form action="/games" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Judul Game</label>
                        <input type="text" name="title" required placeholder="Cth: Catan, Wingspan" 
                            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Kategori</label>
                        <input type="text" name="category" required placeholder="Cth: Strategi, Keluarga, RPG" 
                            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition">
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Durasi (Menit)</label>
                        <input type="number" name="duration" required placeholder="90" 
                            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Tingkat Kesulitan</label>
                        <select name="difficulty" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition">
                            <option value="Mudah">Mudah</option>
                            <option value="Sedang">Sedang</option>
                            <option value="Berat">Berat</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 uppercase tracking-wider mb-1">Ulasan Singkat</label>
                    <textarea name="review" rows="2" placeholder="Tulis kesan atau ulasan singkat..." 
                        class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-white focus:outline-none focus:border-indigo-500 transition"></textarea>
                </div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-medium py-3 rounded-xl transition shadow-lg shadow-indigo-600/20">Simpan Koleksi</button>
            </form>
        </section>

        <!-- Daftar Koleksi & Tombol CRUD (Edit / Hapus) -->
        <section class="space-y-4">
            <h2 class="text-xl font-bold text-slate-200">Daftar Koleksi</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <% if (games.length === 0) { %>
                    <p class="text-slate-500 italic col-span-2 text-center py-8 bg-slate-900/50 rounded-2xl border border-slate-800/50">Belum ada data board game tersimpan.</p>
                <% } else { %>
                    <% games.forEach(game => { %>
                        <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl flex flex-col justify-between space-y-4 shadow-lg">
                            <div class="space-y-2">
                                <div class="flex justify-between items-start">
                                    <h3 class="font-bold text-lg text-indigo-400"><%= game.title %></h3>
                                    <span class="bg-slate-800 text-slate-300 text-xs px-2.5 py-1 rounded-full border border-slate-700"><%= game.category %></span>
                                </div>
                                <div class="text-sm text-slate-400 flex items-center gap-3">
                                    <span>⏱️ <%= game.duration %> Menit</span>
                                    <span>•</span>
                                    <span>📊 Kesulitan: <strong class="text-slate-300"><%= game.difficulty %></strong></span>
                                </div>
                                <% if (game.review) { %>
                                    <p class="text-sm text-slate-300 italic bg-slate-950/50 p-3 rounded-xl border border-slate-800/60">"<%= game.review %>"</p>
                                <% } %>
                            </div>
                            <div class="flex justify-end gap-2 pt-3 border-t border-slate-800/80">
                                <a href="/games/edit/<%= game.id %>" class="px-3.5 py-1.5 bg-amber-500/10 text-amber-400 hover:bg-amber-500/20 text-xs font-medium rounded-lg transition border border-amber-500/20">Edit</a>
                                <form action="/games/delete/<%= game.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus game ini dari koleksi?');">
                                    <button type="submit" class="px-3.5 py-1.5 bg-rose-500/10 text-rose-400 hover:bg-rose-500/20 text-xs font-medium rounded-lg transition border border-rose-500/20">Hapus</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>
    </main>
</body>
</html>