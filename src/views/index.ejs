<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boardgame Vault</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#141414] text-white min-h-screen font-sans">
    
    <header class="sticky top-0 z-50 bg-[#141414]/90 backdrop-blur px-6 py-4 flex justify-between items-center border-b border-zinc-800">
        <h1 class="text-red-600 font-black text-2xl tracking-tighter uppercase">Boardgame Vault</h1>
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-300">
            <a href="/" class="hover:text-white transition">Beranda</a>
            <a href="#katalog" class="hover:text-white transition">Koleksi</a>
            <a href="/games/new" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-xs font-bold uppercase tracking-wider transition shadow-lg shadow-red-600/20">Tambah Baru</a>
        </nav>
    </header>

    <main class="space-y-12 pb-16">
        
        <!-- Hero Banner Carousel (Top 5 Games) -->
        <% if (games.length > 0) { %>
            <% const featuredGames = games.slice(0, 5); %>
            <div class="relative w-full h-[420px] bg-zinc-900 overflow-hidden shadow-2xl" id="hero-carousel">
                <% featuredGames.forEach((game, index) => { %>
                    <div class="hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out <%= index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0' %>" data-index="<%= index %>">
                        <img src="<%= game.image_url %>" alt="<%= game.title %>" class="w-full h-full object-cover opacity-50">
                        <div class="absolute inset-0 bg-gradient-to-t from-[#141414] via-[#141414]/40 to-transparent"></div>
                        <div class="absolute bottom-12 left-6 md:left-12 max-w-xl space-y-3 z-20">
                            <span class="bg-red-600 text-white text-xs font-bold px-2.5 py-1 rounded uppercase"><%= game.category %></span>
                            <h2 class="text-4xl font-extrabold text-white drop-shadow-md"><%= game.title %></h2>
                            <p class="text-sm text-zinc-300 italic line-clamp-2">"<%= game.review || 'Belum ada ulasan.' %>"</p>
                            <div class="flex items-center gap-3 text-xs text-zinc-300 font-semibold">
                                <span class="text-red-500 font-bold uppercase tracking-wider">FEATURED #<%= index + 1 %></span>
                                <span>⏱️ <%= game.duration %> Menit</span>
                                <span class="border border-zinc-600 px-1.5 py-0.5 rounded text-[10px] bg-black/40"><%= game.difficulty %></span>
                            </div>
                        </div>
                    </div>
                <% }) %>

                <% if (featuredGames.length > 1) { %>
                    <div class="absolute bottom-6 right-6 z-30 flex gap-2">
                        <% featuredGames.forEach((_, index) => { %>
                            <button type="button" data-index="<%= index %>" class="carousel-dot w-3 h-3 rounded-full transition-all duration-300 <%= index === 0 ? 'bg-red-600 w-6' : 'bg-zinc-600 hover:bg-zinc-400' %>" aria-label="Slide <%= index + 1 %>"></button>
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <script>
                let currentIndex = 0;
                const slides = document.querySelectorAll('.hero-slide');
                const dots = document.querySelectorAll('.carousel-dot');
                const totalSlides = slides.length;

                function showSlide(index) {
                    slides.forEach((slide, i) => {
                        slide.classList.toggle('opacity-100', i === index);
                        slide.classList.toggle('opacity-0', i !== index);
                        slide.classList.toggle('z-10', i === index);
                        slide.classList.toggle('z-0', i !== index);
                    });
                    dots.forEach((dot, i) => {
                        dot.classList.toggle('bg-red-600', i === index);
                        dot.classList.toggle('w-6', i === index);
                        dot.classList.toggle('bg-zinc-600', i !== index);
                        dot.classList.toggle('w-3', i !== index);
                    });
                    currentIndex = index;
                }

                dots.forEach(dot => {
                    dot.addEventListener('click', () => {
                        const targetIndex = parseInt(dot.getAttribute('data-index'), 10);
                        showSlide(targetIndex);
                    });
                });

                if (totalSlides > 1) {
                    setInterval(() => {
                        let nextIndex = (currentIndex + 1) % totalSlides;
                        showSlide(nextIndex);
                    }, 5000);
                }
            </script>
        <% } %>

        <div class="max-w-7xl mx-auto px-6 space-y-10">

            <!-- Dashboard Summary Statistics -->
            <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wider text-zinc-400 font-semibold">Total Koleksi Game</p>
                        <h3 class="text-2xl font-bold text-white mt-1"><%= stats.total_games %> Game</h3>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-red-600/10 border border-red-600/20 flex items-center justify-center text-red-500">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7v10l8 4"></path>
                        </svg>
                    </div>
                </div>
                <div class="bg-zinc-900 border border-zinc-800 p-5 rounded-xl flex items-center justify-between">
                    <div>
                        <p class="text-xs uppercase tracking-wider text-zinc-400 font-semibold">Rata-Rata Durasi</p>
                        <h3 class="text-2xl font-bold text-white mt-1"><%= stats.avg_duration %> Menit</h3>
                    </div>
                    <div class="w-10 h-10 rounded-lg bg-red-600/10 border border-red-600/20 flex items-center justify-center text-red-500">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </section>

            <!-- Search, Filter, & Sorting Bar -->
            <section class="bg-zinc-900 border border-zinc-800 p-4 rounded-xl">
                <form action="/" method="GET" class="flex flex-col md:flex-row gap-3 items-center justify-between">
                    <input type="text" name="search" value="<%= search %>" placeholder="Cari judul atau kategori game..." 
                        class="w-full md:flex-1 bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600">
                    
                    <div class="w-full md:w-auto flex flex-col sm:flex-row gap-3">
                        <select name="difficulty" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600">
                            <option value="Semua" <%= selectedDifficulty === 'Semua' ? 'selected' : '' %>>Semua Kesulitan</option>
                            <option value="Easy" <%= selectedDifficulty === 'Easy' ? 'selected' : '' %>>Easy</option>
                            <option value="Medium" <%= selectedDifficulty === 'Medium' ? 'selected' : '' %>>Medium</option>
                            <option value="Hard" <%= selectedDifficulty === 'Hard' ? 'selected' : '' %>>Hard</option>
                        </select>

                        <select name="sort" class="bg-zinc-950 border border-zinc-800 rounded-lg px-4 py-2.5 text-sm text-white focus:outline-none focus:border-red-600">
                            <option value="newest" <%= selectedSort === 'newest' ? 'selected' : '' %>>Newest Added</option>
                            <option value="title_asc" <%= selectedSort === 'title_asc' ? 'selected' : '' %>>Title (A - Z)</option>
                            <option value="title_desc" <%= selectedSort === 'title_desc' ? 'selected' : '' %>>Title (Z - A)</option>
                            <option value="duration_asc" <%= selectedSort === 'duration_asc' ? 'selected' : '' %>>Duration (Tercepat)</option>
                            <option value="duration_desc" <%= selectedSort === 'duration_desc' ? 'selected' : '' %>>Duration (Terlama)</option>
                        </select>

                        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-medium px-5 py-2.5 rounded-lg text-sm transition">Cari</button>
                        <% if (search || selectedDifficulty !== 'Semua' || selectedSort !== 'newest') { %>
                            <a href="/" class="bg-zinc-800 hover:bg-zinc-700 text-zinc-300 font-medium px-4 py-2.5 rounded-lg text-sm text-center transition">Reset</a>
                        <% } %>
                    </div>
                </form>
            </section>

            <!-- Katalog Grid -->
            <section id="katalog" class="space-y-4">
                <h3 class="text-xl font-bold text-zinc-200">Daftar Koleksi Vault</h3>
                
                <% if (games.length === 0) { %>
                    <div class="text-zinc-500 italic py-12 text-center bg-zinc-900/40 rounded-xl border border-zinc-800">
                        Tidak ada data game yang cocok dengan pencarian.
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 pt-4">
                        <% games.forEach(game => { %>
                            <div class="group relative bg-zinc-900 rounded-xl overflow-hidden border border-zinc-800 flex flex-col justify-between transition-all duration-300 hover:scale-105 hover:border-zinc-500 hover:shadow-2xl hover:z-30">
                                <div class="relative h-56 w-full bg-zinc-950 overflow-hidden">
                                    <img src="<%= game.image_url %>" alt="<%= game.title %>" class="w-full h-full object-cover transition duration-500 group-hover:scale-110">
                                    <span class="absolute top-2 right-2 bg-black/70 backdrop-blur text-[10px] px-2 py-0.5 rounded text-zinc-300 font-semibold"><%= game.category %></span>
                                </div>
                                <div class="p-4 space-y-2 flex-1 flex flex-col justify-between bg-zinc-900">
                                    <div>
                                        <h4 class="font-bold text-base text-zinc-100 truncate"><%= game.title %></h4>
                                        <p class="text-xs text-zinc-400 mt-0.5">⏱️ <%= game.duration %>m • <%= game.difficulty %></p>
                                    </div>
                                    <div class="max-h-0 overflow-hidden group-hover:max-h-32 transition-all duration-500 ease-in-out opacity-0 group-hover:opacity-100 pt-2 border-t border-zinc-800/60">
                                        <p class="text-xs text-zinc-300 italic">"<%= game.review || 'Tidak ada ulasan.' %>"</p>
                                    </div>
                                    <div class="flex items-center justify-between pt-3 border-t border-zinc-800">
                                        <a href="/games/edit/<%= game.id %>" class="text-xs text-zinc-400 hover:text-white font-medium transition">Edit</a>
                                        <form action="/games/delete/<%= game.id %>" method="POST" onsubmit="return confirm('Hapus game ini?');">
                                            <button type="submit" class="text-xs text-red-400 hover:text-red-300 font-medium transition">Hapus</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>

        </div>
    </main>

    <footer class="border-t border-zinc-800 py-8 text-center text-xs text-zinc-500">
        Boardgame Vault • UTS Cloud Services.
    </footer>
</body>
</html>